# ==============================================================================
# SMART POULTRY PRECISION FARM MANAGEMENT SYSTEM
# Environment Variables & Deployment Configuration Template
# ==============================================================================

# Flask Server
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000
SECRET_KEY=generate_a_random_32_byte_secret_key_here

# JWT Authentication
JWT_SECRET_KEY=generate_another_random_secure_jwt_key_here
JWT_ACCESS_TOKEN_EXPIRES_HOURS=168

# Database Configuration (MySQL 8 or Cloud-Hosted MySQL)
# Option 1: Standard Parameters
DB_ENGINE=mysql
DB_HOST=your-cloud-mysql-host.aivencloud.com
DB_PORT=3306
DB_NAME=smart_poultry
DB_USER=avnadmin
DB_PASSWORD=your_cloud_mysql_password

# Option 2: Unified DATABASE_URL (Supported on Render / Railway / Supabase)
# DATABASE_URL=mysql+pymysql://avnadmin:password@your-cloud-mysql-host:3306/smart_poultry?ssl_ca=...

# For Local Development Fallback:
# If MySQL is not running on 127.0.0.1:3306, the app automatically falls back to SQLite (poultry_farm.db)
